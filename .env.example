# =========================================================
# Star Deeds - Vercel & GitHub Deployment Environment Variables
# =========================================================

# Google Apps Script Web App (RECOMMENDED for Vercel - Zero OAuth setup)
VITE_GOOGLE_APPS_SCRIPT_URL=

# Google OAuth 2.0 Client ID (Optional for direct Google Identity Services popup)
# Note: Add your Vercel URL to "Authorized JavaScript origins" in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=

# Firebase Firestore Configuration (Optional - will use bundled config if omitted)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API Key (Server-side AI features if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL (Auto-injected in AI Studio Cloud Run)
APP_URL="MY_APP_URL"

